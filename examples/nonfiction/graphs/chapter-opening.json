    {
      "id": "house-style",
      "kind": "input",
      "params": { "type": "style", "label": "House style" },
      "position": { "x": 0, "y": 320 }
    },
    {
      "id": "mystery",
      "kind": "tool",
      "tool": "mystery_question",
      "params": {
        "puzzle": "Why does one figure about practice hours get quoted as a rule?"
